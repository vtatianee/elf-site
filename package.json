{
  "name": "elf-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static site (Next.js static export) with Christmas elf night ideas. Deployed on Cloudflare Pages.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prebuild.ts && next build && node scripts/check-export.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:config": "node scripts/prebuild.ts --check-only"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
