# Response headers for Cloudflare Pages. This file is copied as-is to out/_headers.
# Syntax: a path pattern, then indented "Name: value" lines.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# There is NO "X-Robots-Tag" / noindex here, on purpose: every page may be indexed.

# --- Every file: security headers --------------------------------------------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Notes on the Content-Security-Policy above:
# - 'unsafe-inline' for scripts is required: a static Next.js export writes the
#   page data as small inline scripts and cannot use nonces (there is no server).
#   The site takes no user input and stores nothing server-side, so the risk is low.
# - 'unsafe-inline' for styles allows style="" attributes.
# - The two cloudflareinsights.com hosts are for the OPTIONAL Cloudflare Web
#   Analytics slot (off by default). Nothing else is allowed: no ads, no other
#   tracker, no third-party font host.
# - Links that leave the site (Amazon, Pinterest) are plain links and are not
#   affected by this policy.
# - When an email provider is chosen, its form address must be added to
#   "form-action" (and "connect-src" if the form is sent by script).

# --- Build files with a hash in the name: cache "forever" --------------------
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# --- Illustrations and their JPEG copies --------------------------------------
# Short browser cache: the owner replaces these files under the same name, and
# the new picture must show up without waiting.
/illustrations/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/social/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
